@using SportEase.Web.Models.ViewModels
@model TerrainSearchViewModel
@{
    ViewData["Title"] = "Rechercher un terrain";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="fas fa-search me-2"></i>Recherche avancée</h2>

    <!-- Formulaire de recherche -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="SportType" class="form-label">Type de sport</label>
                        <select asp-for="SportType" class="form-select">
                            <option value="">Tous</option>
                            <option value="Football">Football</option>
                            <option value="Basketball">Basketball</option>
                            <option value="Tennis">Tennis</option>
                            <option value="Volleyball">Volleyball</option>
                            <option value="Handball">Handball</option>
                            <option value="Badminton">Badminton</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="City" class="form-label">Ville</label>
                        <input asp-for="City" class="form-control" placeholder="Ex: Tunis">
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Date" class="form-label">Date</label>
                        <input asp-for="Date" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>

                    <div class="col-md-2">
                        <label asp-for="MinPrice" class="form-label">Prix min (DT)</label>
                        <input asp-for="MinPrice" class="form-control" type="number" placeholder="0">
                    </div>

                    <div class="col-md-2">
                        <label asp-for="MaxPrice" class="form-label">Prix max (DT)</label>
                        <input asp-for="MaxPrice" class="form-control" type="number" placeholder="100">
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MinCapacity" class="form-label">Capacité minimum</label>
                        <input asp-for="MinCapacity" class="form-control" type="number" placeholder="Ex: 10">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label d-block">Équipements</label>
                        <div class="form-check form-check-inline">
                            <input asp-for="HasLighting" class="form-check-input">
                            <label asp-for="HasLighting" class="form-check-label">Éclairage</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="HasParking" class="form-check-input">
                            <label asp-for="HasParking" class="form-check-label">Parking</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="HasChangingRoom" class="form-check-input">
                            <label asp-for="HasChangingRoom" class="form-check-label">Vestiaires</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="SortBy" class="form-label">Trier par</label>
                        <select asp-for="SortBy" class="form-select">
                            <option value="Name">Nom</option>
                            <option value="PriceAsc">Prix croissant</option>
                            <option value="PriceDesc">Prix décroissant</option>
                            <option value="Capacity">Capacité</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Rechercher
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Résultats -->
    @if (Model.Results != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">@Model.TotalResults résultat(s) trouvé(s)</h5>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-times me-2"></i>Réinitialiser
            </a>
        </div>

        @if (Model.Results.Any())
        {
            <div class="row g-4">
                @foreach (var terrain in Model.Results)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card terrain-card h-100 shadow-sm hover-lift">
                            <div class="terrain-image position-relative">
                                @if (!string.IsNullOrEmpty(terrain.ImageUrl))
                                {
                                    <img src="@terrain.ImageUrl" class="card-img-top" alt="@terrain.Name" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="terrain-placeholder d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                        <i class="fas fa-image fa-3x text-muted"></i>
                                    </div>
                                }
                                <span class="badge-sport position-absolute top-0 end-0 m-3 badge bg-primary">
                                    @terrain.SportType
                                </span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@terrain.Name</h5>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-map-marker-alt me-1"></i>@terrain.FullAddress
                                </p>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-users me-1"></i>Capacité: @terrain.Capacity joueurs
                                </p>

                                @if (!string.IsNullOrEmpty(terrain.FeaturesDisplay))
                                {
                                    <div class="terrain-features mb-3">
                                        @foreach (var feature in terrain.FeaturesDisplay.Split(','))
                                        {
                                            <span class="badge bg-light text-dark me-1">@feature.Trim()</span>
                                        }
                                    </div>
                                }

                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="h4 text-primary fw-bold mb-0">@terrain.PricePerHour.ToString("F2") DT</span>
                                        <small class="text-muted d-block">par heure</small>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@terrain.Id" class="btn btn-primary">
                                        Voir détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2"></i>Aucun terrain ne correspond à vos critères. Essayez de modifier vos filtres.
            </div>
        }
    }
</div>
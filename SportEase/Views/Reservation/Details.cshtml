@using SportEase.ViewModels
@model ReservationDetailsViewModel
@{
    ViewData["Title"] = "Détails de la réservation";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MyBookings">Mes réservations</a></li>
            <li class="breadcrumb-item active">Réservation #@Model.Reservation.Id</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Détails de la réservation</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5 class="fw-bold">Statut</h5>
                        <h3><span class="@Model.Reservation.StatusBadgeClass">@Model.Reservation.StatusDisplayText</span></h3>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Date de réservation</h6>
                            <p class="h5"><i class="fas fa-calendar me-2"></i>@Model.Reservation.FormattedDate</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Heure</h6>
                            <p class="h5"><i class="fas fa-clock me-2"></i>@Model.Reservation.TimeSlot</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Durée</h6>
                            <p class="h5">@Model.Reservation.DurationHours heure(s)</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Prix total</h6>
                            <p class="h5 text-primary fw-bold">@Model.Reservation.TotalPrice.ToString("F2") DT</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Reservation.CancellationReason))
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="fas fa-info-circle me-2"></i>Raison de l'annulation</h6>
                            <p class="mb-0">@Model.Reservation.CancellationReason</p>
                        </div>
                    }

                    <hr>

                    <h5 class="fw-bold mb-3">Informations du terrain</h5>
                    <div class="card bg-light">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h5 class="fw-bold">@Model.Reservation.Terrain.Name</h5>
                                    <p class="mb-1">
                                        <i class="fas fa-map-marker-alt me-1"></i>@Model.Reservation.Terrain.FullAddress
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-tag me-1"></i>@Model.Reservation.Terrain.SportType
                                    </p>
                                    <p class="mb-0">
                                        <i class="fas fa-users me-1"></i>Capacité: @Model.Reservation.Terrain.Capacity joueurs
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a asp-controller="Terrain" asp-action="Details" asp-route-id="@Model.Reservation.TerrainId"
                                       class="btn btn-outline-primary">
                                        <i class="fas fa-eye me-2"></i>Voir le terrain
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Créée le</h6>
                            <p>@Model.Reservation.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Dernière modification</h6>
                            <p>@Model.Reservation.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.CanCancel)
                    {
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            Cette réservation peut être annulée jusqu'à 24h avant.
                            <br>
                            <small>Temps restant: @Model.HoursUntilReservation heures</small>
                        </div>

                        <a asp-action="Cancel" asp-route-id="@Model.Reservation.Id"
                           class="btn btn-danger w-100 mb-2">
                            <i class="fas fa-times-circle me-2"></i>Annuler la réservation
                        </a>
                    }
                    else if (Model.Reservation.IsPending || Model.Reservation.IsConfirmed)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Cette réservation ne peut plus être annulée (moins de 24h avant).
                        </div>
                    }

                    <a asp-action="MyBookings" class="btn btn-outline-primary w-100">
                        <i class="fas fa-arrow-left me-2"></i>Retour à mes réservations
                    </a>

                    @if (Model.Reservation.IsConfirmed || Model.Reservation.IsPending)
                    {
                        <hr>
                        <h6 class="fw-bold mb-3">Contact du propriétaire</h6>
                        <p class="mb-1"><strong>Nom:</strong> @Model.Reservation.Terrain.Admin.FullName</p>
                        <p class="mb-0"><strong>Téléphone:</strong> @Model.Reservation.Terrain.Admin.Phone</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@using SportEase.Web.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Administrateur";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="fas fa-chart-line me-2"></i>Dashboard Administrateur</h2>

    <!-- Statistiques principales -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card bg-gradient-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 opacity-75">Terrains actifs</h6>
                            <h2 class="mb-0 fw-bold">@Model.ActiveTerrains / @Model.TotalTerrains</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-map-marked-alt fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-gradient-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 opacity-75">Réservations aujourd'hui</h6>
                            <h2 class="mb-0 fw-bold">@Model.TodayReservations</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-calendar-day fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-gradient-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 opacity-75">En attente</h6>
                            <h2 class="mb-0 fw-bold">@Model.PendingReservations</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-hourglass-half fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-gradient-info text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 opacity-75">Revenus ce mois</h6>
                            <h2 class="mb-0 fw-bold">@Model.MonthlyRevenue.ToString("F0") DT</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-money-bill-wave fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Graphique des réservations -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Réservations par mois</h5>
                </div>
                <div class="card-body">
                    <canvas id="reservationsChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Top terrains -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i>Top Terrains</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopTerrains.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var terrain in Model.TopTerrains)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@terrain.Name</h6>
                                            <small class="text-muted">@terrain.SportType</small>
                                        </div>
                                        <span class="badge bg-primary rounded-pill">
                                            @terrain.Reservations.Count réservations
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Aucune donnée disponible</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides et réservations en attente -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Réservations en attente</h5>
                </div>
                <div class="card-body">
                    @if (Model.PendingReservations > 0)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Vous avez <strong>@Model.PendingReservations réservation(s)</strong> en attente de confirmation
                        </div>
                        <a asp-action="Reservations" class="btn btn-warning w-100">
                            <i class="fas fa-eye me-2"></i>Voir les réservations en attente
                        </a>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="fas fa-check-circle fa-3x mb-2"></i>
                            <p>Aucune réservation en attente</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="CreateTerrain" class="btn btn-success">
                            <i class="fas fa-plus-circle me-2"></i>Ajouter un terrain
                        </a>
                        <a asp-action="Terrains" class="btn btn-primary">
                            <i class="fas fa-list me-2"></i>Gérer mes terrains
                        </a>
                        <a asp-action="Reservations" class="btn btn-info">
                            <i class="fas fa-calendar-check me-2"></i>Voir toutes les réservations
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Revenus totaux -->
    <div class="card shadow-sm">
        <div class="card-body text-center">
            <h5 class="text-muted mb-2">Revenus totaux (tous les temps)</h5>
            <h2 class="text-success fw-bold mb-0">@Model.TotalRevenue.ToString("F2") DT</h2>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Graphique des réservations
        const ctx = document.getElementById('reservationsChart').getContext('2d');
        const reservationsChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ReservationsByMonth.Keys)),
                datasets: [{
                    label: 'Réservations',
                    data: @Html.Raw(Json.Serialize(Model.ReservationsByMonth.Values)),
                    backgroundColor: 'rgba(102, 126, 234, 0.8)',
                    borderColor: 'rgba(102, 126, 234, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    </script>
}
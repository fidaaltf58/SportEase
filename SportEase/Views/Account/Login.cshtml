@using SportEase.Web.Models.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-sign-in-alt fa-3x text-primary mb-3"></i>
                        <h2 class="fw-bold">Connexion</h2>
                        <p class="text-muted">Accédez à votre compte SportEase</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="votre@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Se souvenir de moi</label>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0">
                                Pas encore de compte ?
                                <a asp-action="Register" class="text-decoration-none fw-bold">Inscrivez-vous</a>
                            </p>
                        </div>
                    </form>

                    <!-- Comptes de test -->
                    <div class="mt-4 p-3 bg-light rounded">
                        <small class="text-muted d-block mb-2"><strong>Comptes de test:</strong></small>
                        <small class="d-block">
                            <strong>Admin:</strong> admin@sportease.com / Admin@123
                        </small>
                        <small class="d-block">
                            <strong>User:</strong> user@sportease.com / User@123
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
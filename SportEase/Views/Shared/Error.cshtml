@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-1 text-danger">
            <i class="fas fa-exclamation-triangle"></i>
        </h1>
        <h2 class="display-4">Oups ! Une erreur est survenue</h2>
        <p class="lead text-muted">Nous sommes désolés, quelque chose s'est mal passé.</p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="text-muted">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-home me-2"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
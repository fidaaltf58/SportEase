@using SportEase.Web.Models.ViewModels
@model CancelReservationViewModel
@{
    ViewData["Title"] = "Annuler la réservation";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Annuler la réservation</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Attention !</strong> Vous êtes sur le point d'annuler votre réservation.
                        Cette action est irréversible.
                    </div>

                    <h5 class="fw-bold mb-3">Détails de la réservation</h5>
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <p class="mb-1"><strong>Terrain:</strong> @Model.Reservation.Terrain.Name</p>
                            <p class="mb-1"><strong>Date:</strong> @Model.Reservation.FormattedDate</p>
                            <p class="mb-1"><strong>Heure:</strong> @Model.Reservation.TimeSlot</p>
                            <p class="mb-0"><strong>Prix:</strong> @Model.Reservation.TotalPrice.ToString("F2") DT</p>
                        </div>
                    </div>

                    <form asp-action="CancelConfirmed" method="post">
                        <input type="hidden" asp-for="ReservationId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="CancellationReason" class="form-label fw-bold">
                                Veuillez indiquer la raison de l'annulation *
                            </label>
                            <textarea asp-for="CancellationReason" class="form-control" rows="4"
                                      placeholder="Ex: Changement de programme, mauvais temps prévu, etc."></textarea>
                            <span asp-validation-for="CancellationReason" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-times-circle me-2"></i>Confirmer l'annulation
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.ReservationId" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
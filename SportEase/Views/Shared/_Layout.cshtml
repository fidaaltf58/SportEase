<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportEase</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fas fa-running me-2"></i>SportEase
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Terrain" asp-action="Index">Terrains</a>
                    </li>

                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        var userRole = Context.Session.GetString("UserRole");
                        var userName = Context.Session.GetString("UserName");

                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Terrains">Mes Terrains</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reservations">Réservations</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservation" asp-action="Dashboard">Mon Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservation" asp-action="MyBookings">Mes Réservations</a>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@userName
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Mon Profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Déconnexion</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm ms-2" asp-controller="Account" asp-action="Register">Inscription</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Toast Container for Notifications -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-primary text-white">
                <i class="fas fa-bell me-2"></i>
                <strong class="me-auto">Notification</strong>
                <small>À l'instant</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastMessage">
                <!-- Message content -->
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="fas fa-running me-2"></i>SportEase</h5>
                    <p class="text-muted">Réservez votre terrain sportif en quelques clics</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Liens Rapides</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted text-decoration-none">À propos</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Contact</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Conditions d'utilisation</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Suivez-nous</h6>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-twitter fa-lg"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center text-muted">
                <small>&copy; @DateTime.Now.Year SportEase - Tous droits réservés</small>
                <div class="mt-2">
                    <small>Server Status: <span id="signalrStatus" class="badge bg-secondary">Connecting...</span></small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var userId = '@Context.Session.GetInt32("UserId")';
        var userRole = '@Context.Session.GetString("UserRole")';

        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/reservationHub?userId=" + userId + "&role=" + userRole)
            .withAutomaticReconnect()
            .build();

        function showNotification(message, isSuccess = true) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: isSuccess ? 'success' : 'error',
                title: message,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        }

        function showPopup(title, message, isSuccess = true) {
            Swal.fire({
                title: title,
                text: message,
                icon: isSuccess ? 'success' : 'error',
                confirmButtonText: 'OK',
                confirmButtonColor: '#0d6efd'
            });
        }

        connection.on("ReservationUpdated", function (message) {
            console.log("Reservation updated notification received");
            
            if (message) {
                showNotification(message);
            }

            // Real-time UI refresh - Aggressive check
            var path = window.location.pathname.toLowerCase();
            if (path.includes("dashboard") || path.includes("reservations") || path.includes("bookings") || path.includes("admin")) {
                setTimeout(function() {
                    console.log("Reloading page...");
                    // Optional: Show a small toast saying "Updating list..."
                    window.location.reload(); 
                }, 1500); 
            }
        });

        connection.start().then(function () {
            console.log("SignalR Connected");
            var statusEl = document.getElementById('signalrStatus');
            if(statusEl) {
                statusEl.textContent = "Connected";
                statusEl.classList.replace('bg-secondary', 'bg-success');
                statusEl.classList.replace('bg-danger', 'bg-success');
            }
        }).catch(function (err) {
            console.error("SignalR Connection Error: " + err.toString());
            var statusEl = document.getElementById('signalrStatus');
            if(statusEl) {
                statusEl.textContent = "Disconnected";
                statusEl.classList.replace('bg-secondary', 'bg-danger');
                statusEl.classList.replace('bg-success', 'bg-danger');
            }
        });

        // Show TempData as SweetAlert if present
        document.addEventListener('DOMContentLoaded', function() {
            var successMsg = '@TempData["SuccessMessage"]';
            var errorMsg = '@TempData["ErrorMessage"]';

            if (successMsg && successMsg.length > 0) {
                showPopup('Succès', successMsg, true);
            }
            
            if (errorMsg && errorMsg.length > 0) {
                showPopup('Attention', errorMsg, false);
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
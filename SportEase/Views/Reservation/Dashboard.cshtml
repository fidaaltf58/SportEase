@using SportEase.Web.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Mon Dashboard";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="fas fa-tachometer-alt me-2"></i>Mon Dashboard</h2>

    <!-- Statistiques -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Total réservations</h6>
                            <h2 class="mb-0">@Model.TotalReservations</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-calendar fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-success text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">À venir</h6>
                            <h2 class="mb-0">@Model.UpcomingReservations</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-calendar-check fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-info text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Complétées</h6>
                            <h2 class="mb-0">@Model.CompletedReservations</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Total dépensé</h6>
                            <h2 class="mb-0">@Model.TotalSpent.ToString("F0") DT</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Prochaines réservations -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Prochaines réservations</h5>
                </div>
                <div class="card-body">
                    @if (Model.NextReservations.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var reservation in Model.NextReservations)
                            {
                                <a asp-action="Details" asp-route-id="@reservation.Id"
                                   class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1 fw-bold">@reservation.Terrain.Name</h6>
                                            <p class="mb-1 small text-muted">
                                                <i class="fas fa-calendar me-1"></i>@reservation.FormattedDate
                                                <span class="mx-1">•</span>
                                                <i class="fas fa-clock me-1"></i>@reservation.TimeSlot
                                            </p>
                                            <span class="@reservation.StatusBadgeClass">@reservation.StatusDisplayText</span>
                                        </div>
                                        <div class="text-end">
                                            <strong class="text-primary">@reservation.TotalPrice.ToString("F2") DT</strong>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-action="MyBookings" class="btn btn-outline-primary btn-sm">
                                Voir toutes mes réservations <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-calendar-times fa-3x mb-3"></i>
                            <p>Aucune réservation à venir</p>
                            <a asp-controller="Terrain" asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-search me-2"></i>Rechercher un terrain
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Activité récente -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Activité récente</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentReservations.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var reservation in Model.RecentReservations)
                            {
                                <a asp-action="Details" asp-route-id="@reservation.Id"
                                   class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1 fw-bold">@reservation.Terrain.Name</h6>
                                            <p class="mb-1 small text-muted">
                                                <i class="fas fa-calendar me-1"></i>@reservation.FormattedDate
                                            </p>
                                            <span class="@reservation.StatusBadgeClass">@reservation.StatusDisplayText</span>
                                        </div>
                                        <div class="text-end">
                                            <strong>@reservation.TotalPrice.ToString("F2") DT</strong>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-inbox fa-3x mb-3"></i>
                            <p>Aucune activité récente</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Actions rapides</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-controller="Terrain" asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="fas fa-search me-2"></i>Rechercher un terrain
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-action="MyBookings" class="btn btn-outline-info w-100">
                        <i class="fas fa-list me-2"></i>Mes réservations
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-user me-2"></i>Mon profil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
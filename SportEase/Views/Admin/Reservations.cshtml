@using SportEase.Web.Models.ViewModels
@model AdminReservationListViewModel
@{
    ViewData["Title"] = "Gestion des réservations";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="fas fa-calendar-check me-2"></i>Gestion des réservations</h2>

    <!-- Statistiques -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6 class="opacity-75">Total réservations</h6>
                    <h2 class="mb-0">@Model.TotalReservations</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h6 class="opacity-75">En attente</h6>
                    <h2 class="mb-0">@Model.PendingReservations.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="opacity-75">Revenus totaux</h6>
                    <h2 class="mb-0">@Model.TotalRevenue.ToString("F2") DT</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filtres</h5>
        </div>
        <div class="card-body">
            <form asp-action="Reservations" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="FilterTerrainId" class="form-label">Terrain</label>
                        <select asp-for="FilterTerrainId" class="form-select">
                            <option value="">Tous les terrains</option>
                            @foreach (var terrain in Model.AdminTerrains)
                            {
                                <option value="@terrain.Id">@terrain.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FilterStatus" class="form-label">Statut</label>
                        <select asp-for="FilterStatus" class="form-select">
                            <option value="">Tous les statuts</option>
                            <option value="Pending">En attente</option>
                            <option value="Confirmed">Confirmée</option>
                            <option value="Cancelled">Annulée</option>
                            <option value="Completed">Terminée</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="FilterStartDate" class="form-label">Date début</label>
                        <input asp-for="FilterStartDate" class="form-control" type="date">
                    </div>

                    <div class="col-md-2">
                        <label asp-for="FilterEndDate" class="form-label">Date fin</label>
                        <input asp-for="FilterEndDate" class="form-control" type="date">
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Filtrer
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#all">
                Toutes (@Model.AllReservations.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#today">
                Aujourd'hui (@Model.TodayReservations.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#pending">
                En attente (@Model.PendingReservations.Count)
            </a>
        </li>
    </ul>

    <!-- Contenu des tabs -->
    <div class="tab-content">
        <!-- Toutes les réservations -->
        <div class="tab-pane fade show active" id="all">
            @if (Model.AllReservations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Terrain</th>
                                <th>Date</th>
                                <th>Horaire</th>
                                <th>Prix</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model.AllReservations)
                            {
                                <tr>
                                    <td>
                                        <strong>@reservation.User.FullName</strong><br>
                                        <small class="text-muted">@reservation.User.Phone</small>
                                    </td>
                                    <td>@reservation.Terrain.Name</td>
                                    <td>@reservation.FormattedDate</td>
                                    <td>@reservation.TimeSlot</td>
                                    <td><strong>@reservation.TotalPrice.ToString("F2") DT</strong></td>
                                    <td><span class="@reservation.StatusBadgeClass">@reservation.StatusDisplayText</span></td>
                                    <td>
                                        @if (reservation.Status == "Pending")
                                        {
                                            <form asp-action="ConfirmReservation" asp-route-id="@reservation.Id" method="post" class="d-inline confirm-form">
                                                <button type="submit" class="btn btn-sm btn-success" title="Confirmer">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal@(reservation.Id)" title="Refuser">
                                                <i class="fas fa-times"></i>
                                            </button>

                                            <!-- Modal de refus -->
                                            <div class="modal fade" id="rejectModal@(reservation.Id)" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Refuser la réservation</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-action="RejectReservation" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@reservation.Id">
                                                                <div class="mb-3">
                                                                    <label class="form-label">Raison du refus *</label>
                                                                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                                <button type="submit" class="btn btn-danger">Refuser</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Aucune réservation trouvée.
                </div>
            }
        </div>

        <!-- Réservations aujourd'hui -->
        <div class="tab-pane fade" id="today">
            @if (Model.TodayReservations.Any())
            {
                <div class="list-group">
                    @foreach (var reservation in Model.TodayReservations)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <h6 class="mb-0">@reservation.User.FullName</h6>
                                    <small class="text-muted">@reservation.User.Phone</small>
                                </div>
                                <div class="col-md-3">
                                    <strong>@reservation.Terrain.Name</strong>
                                </div>
                                <div class="col-md-2">
                                    <i class="fas fa-clock me-1"></i>@reservation.TimeSlot
                                </div>
                                <div class="col-md-2">
                                    <span class="@reservation.StatusBadgeClass">@reservation.StatusDisplayText</span>
                                </div>
                                <div class="col-md-2 text-end">
                                    <strong>@reservation.TotalPrice.ToString("F2") DT</strong>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Aucune réservation aujourd'hui.
                </div>
            }
        </div>

        <!-- Réservations en attente -->
        <div class="tab-pane fade" id="pending">
            @if (Model.PendingReservations.Any())
            {
                <div class="alert alert-warning mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>@Model.PendingReservations.Count réservation(s)</strong> en attente de votre confirmation
                </div>

                <div class="list-group">
                    @foreach (var reservation in Model.PendingReservations)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <h6 class="mb-1">@reservation.User.FullName</h6>
                                    <p class="mb-0 small text-muted">
                                        <i class="fas fa-phone me-1"></i>@reservation.User.Phone<br>
                                        <i class="fas fa-envelope me-1"></i>@reservation.User.Email
                                    </p>
                                </div>
                                <div class="col-md-3">
                                    <strong>@reservation.Terrain.Name</strong><br>
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>@reservation.FormattedDate<br>
                                        <i class="fas fa-clock me-1"></i>@reservation.TimeSlot
                                    </small>
                                </div>
                                <div class="col-md-2 text-center">
                                    <h5 class="text-primary mb-0">@reservation.TotalPrice.ToString("F2") DT</h5>
                                </div>
                                <div class="col-md-3 text-end">
                                    <form asp-action="ConfirmReservation" asp-route-id="@reservation.Id" method="post" class="d-inline confirm-form">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-check me-1"></i>Confirmer
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                            data-bs-target="#rejectModal@(reservation.Id)">
                                        <i class="fas fa-times me-1"></i>Refuser
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>Aucune réservation en attente de confirmation.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.confirm-form').on('submit', function(e) {
                // Fallback if SweetAlert isn't loaded
                if (typeof Swal === 'undefined') {
                    return;
                }

                e.preventDefault();
                var form = this;
                
                Swal.fire({
                    title: 'Confirmer la réservation',
                    text: "Êtes-vous sûr de vouloir confirmer cette réservation ?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Oui, confirmer',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Confirmation...',
                            html: 'Veuillez patienter.',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        form.submit();
                    }
                });
            });
        });
    </script>
}
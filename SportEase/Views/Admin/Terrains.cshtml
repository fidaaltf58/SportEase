@using SportEase.Web.Models.ViewModels
@model TerrainListViewModel
@{
    ViewData["Title"] = "Mes Terrains";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-map-marked-alt me-2"></i>Mes Terrains</h2>
            <p class="text-muted mb-0">Gérez vos terrains sportifs</p>
        </div>
        <a asp-action="CreateTerrain" class="btn btn-success btn-lg">
            <i class="fas fa-plus-circle me-2"></i>Ajouter un terrain
        </a>
    </div>

    <!-- Statistiques -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="opacity-75">Total terrains</h6>
                    <h2 class="mb-0">@Model.TotalTerrains</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="opacity-75">Terrains actifs</h6>
                    <h2 class="mb-0">@Model.ActiveTerrains</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h6 class="opacity-75">Terrains inactifs</h6>
                    <h2 class="mb-0">@Model.InactiveTerrains</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des terrains -->
    @if (Model.Terrains.Any())
    {
        <div class="row g-4">
            @foreach (var terrain in Model.Terrains)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm @(!terrain.IsActive ? "opacity-50" : "")">
                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(terrain.ImageUrl))
                            {
                                <img src="@terrain.ImageUrl" class="card-img-top" alt="@terrain.Name" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                </div>
                            }
                            <span class="position-absolute top-0 end-0 m-2 badge bg-primary">@terrain.SportType</span>
                            @if (!terrain.IsActive)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger">Inactif</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@terrain.Name</h5>
                            <p class="text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i>@terrain.City
                            </p>
                            <p class="mb-2">
                                <i class="fas fa-users me-1"></i>Capacité: @terrain.Capacity joueurs
                            </p>
                            <p class="mb-3">
                                <strong class="text-primary">@terrain.PricePerHour.ToString("F2") DT</strong> / heure
                            </p>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @if (terrain.HasLighting)
                                {
                                    <span class="badge bg-light text-dark"><i class="fas fa-lightbulb me-1"></i>Éclairage</span>
                                }
                                @if (terrain.HasParking)
                                {
                                    <span class="badge bg-light text-dark"><i class="fas fa-parking me-1"></i>Parking</span>
                                }
                                @if (terrain.HasChangingRoom)
                                {
                                    <span class="badge bg-light text-dark"><i class="fas fa-door-open me-1"></i>Vestiaires</span>
                                }
                            </div>

                            <div class="border-top pt-3">
                                <p class="mb-2 small">
                                    <i class="fas fa-calendar-check me-1"></i>
                                    <strong>@terrain.Reservations.Count</strong> réservation(s)
                                </p>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <div class="d-flex gap-2">
                                <a asp-action="EditTerrain" asp-route-id="@terrain.Id" class="btn btn-sm btn-primary flex-fill">
                                    <i class="fas fa-edit me-1"></i>Modifier
                                </a>
                                <a asp-controller="Terrain" asp-action="Details" asp-route-id="@terrain.Id"
                                   class="btn btn-sm btn-outline-primary flex-fill" target="_blank">
                                    <i class="fas fa-eye me-1"></i>Voir
                                </a>
                                <form asp-action="DeleteTerrain" asp-route-id="@terrain.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir archiver ce terrain ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-archive"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-map-marked-alt fa-5x text-muted mb-4"></i>
                <h4 class="text-muted mb-3">Aucun terrain pour le moment</h4>
                <p class="text-muted mb-4">Commencez par ajouter votre premier terrain</p>
                <a asp-action="CreateTerrain" class="btn btn-success btn-lg">
                    <i class="fas fa-plus-circle me-2"></i>Ajouter mon premier terrain
                </a>
            </div>
        </div>
    }
</div>